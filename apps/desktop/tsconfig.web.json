{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "ignoreDeprecations": "5.0",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "outDir": "./dist/.types-web"
  },
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/simulator" }
  ],
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/preload/electron-api.d.ts",
    "src/preload/electron-api-types.ts"
  ]
}

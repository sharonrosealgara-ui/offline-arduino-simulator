{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "offline-arduino://schemas/circuit.schema.json",
  "title": "ProjectCircuit",
  "type": "object",
  "required": ["schemaVersion", "components", "wires", "junctions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": ["id", "kind", "x", "y", "rotation", "label", "properties"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "maxLength": 128 },
          "kind": { "enum": ["uno-r3", "led", "resistor", "pushbutton", "potentiometer", "lcd1602", "servo"] },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "rotation": { "enum": [0, 90, 180, 270] },
          "label": { "type": "string", "maxLength": 64 },
          "properties": { "type": "object" }
        }
      }
    },
    "wires": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "colorRole", "waypoints"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "maxLength": 128 },
          "from": { "$ref": "#/definitions/terminalRef" },
          "to": { "$ref": "#/definitions/terminalRef" },
          "colorRole": { "enum": ["vcc-red", "ground-black", "signal-yellow", "signal-blue", "signal-green", "signal-orange", "signal-purple"] },
          "waypoints": { "type": "array", "items": { "$ref": "#/definitions/point" }, "maxItems": 64 }
        }
      }
    },
    "junctions": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": ["id", "wireIds", "point"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "maxLength": 128 },
          "wireIds": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
          "point": { "$ref": "#/definitions/point" }
        }
      }
    }
  },
  "definitions": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "terminalRef": {
      "type": "object",
      "required": ["componentId", "terminalId"],
      "additionalProperties": false,
      "properties": { "componentId": { "type": "string", "maxLength": 128 }, "terminalId": { "type": "string", "maxLength": 64 } }
    }
  }
}
